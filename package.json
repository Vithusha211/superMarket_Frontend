{
  "name": "supermarket",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run start:go",
    "start:go": "npx expo start --go --lan --clear --port 8083",
    "start:go:tunnel": "npx expo start --go --tunnel --clear",
    "start:lan": "npx expo start --go --lan --clear --port 8081",
    "start:windows": "call start-expo.bat",
    "start:tunnel": "npx expo start --go --tunnel --clear",
    "start:localhost": "npx expo start --go --localhost --port 8081",
    "start:dev": "npx expo start --dev-client --lan --port 8082",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "start:web": "npx expo start --web --port 8081",
    "android": "expo start --android --go --lan",
    "ios": "expo start --ios --go --lan",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/joti-one": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@kinde/expo": "^0.9.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.28",
    "expo-auth-session": "~57.0.15",
    "expo-blur": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/cli": "~57.0.25",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
