# Leave empty so Expo can pick the correct connection automatically.
EXPO_NO_DEPENDENCY_VALIDATION=1

# Google sign-in runs on the native Android SDK and requires a development
# build (it cannot run in Expo Go).
# Optional: "Web application" OAuth client ID from Google Cloud Console.
# Only needed if you want ID tokens for your own backend server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
