# Kinde Frontend app settings (public client ID; do not add a client secret).
# Allow happycart:// as both a callback URL and logout redirect URL in Kinde.
EXPO_PUBLIC_KINDE_DOMAIN=
EXPO_PUBLIC_KINDE_CLIENT_ID=
# Optional provider connection IDs to open each provider directly.
EXPO_PUBLIC_KINDE_GOOGLE_CONNECTION_ID=
EXPO_PUBLIC_KINDE_FACEBOOK_CONNECTION_ID=
# Without a provider connection ID, Kinde shows its hosted login page.
