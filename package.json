{
  "name": "supermarket",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "call start-expo.bat",
    "start:lan": "set \"EXPO_NO_DEPENDENCY_VALIDATION=1\" && set \"REACT_NATIVE_PACKAGER_HOSTNAME=192.168.8.135\" && npx expo start --lan --port 8081",
    "start:windows": "call start-expo.bat",
    "start:tunnel": "npx expo start --tunnel",
    "start:localhost": "npx expo start --localhost --port 8081",
    "start:web": "npx expo start --web --port 8081",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/joti-one": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.35",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
